# Copy to .env and replace passwords. Keep this file private.
# URL-encode @, #, /, : and other special characters inside passwords.
DATABASE_URL=mysql+pymysql://studentbridge_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/studentbridge_ai?charset=utf8mb4
APP_ENV=development
APP_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
# Optional grounded language rewriting; not needed for financial rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL SECURE CARD CHECKOUT - leave blank until an approved merchant connects it.
# NEVER put these keys in HTML, JavaScript, or GitHub.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
AUTHORIZED_PAYEE_NAME=
AUTHORIZED_INVOICE_REFERENCE=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Real charges require licensed/authorized merchant, verified invoice and HTTPS.
CARD_LIVE_ENABLED=false
MERCHANT_AUTHORIZED_TO_COLLECT=false
